  "narrative": {
    "northStar": "The Sliding Black Glass",
    "overview": "T-Drop's shelf is a sheet of near-black glass that slides in from the screen edge over whatever the user is doing. It is silent at rest and instant when called.",
    "keyCharacteristics": [
      "Near-black layered surfaces, white text at three opacities",
      "Big radii (24 / 18 / pill), almost no borders or card shadows",
      "One theme-swappable accent for active, focus and glow only",
      "Short precise motion (140ms / 240ms)",
      "Built for any language, including RTL"
    ],
    "rules": [
      {
        "name": "The Rare Accent Rule",
        "body": "The accent covers only active, focus and glow states, roughly 10% of any screen.",
        "section": "colors"
      },
      {
        "name": "The Scaled Type Rule",
        "body": "Every font size is calc(Npx * var(--font-scale, 1)).",
        "section": "typography"
      },
      {
        "name": "The Tonal-First Rule",
        "body": "Raise a surface by making it lighter, not by adding a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do read colour, radius and motion from tokens.css",
      "Do use the white-on-black inverted pill for selected",
      "Do test long strings and RTL",
      "Do keep motion between 140ms and 240ms"
    ],
    "donts": [
      "Don't hard-code #8b5cf6",
      "Don't use accent for decoration",
      "Don't add heavy borders or drop shadows to cards",
      "Don't hard-code Vietnamese or English text",
      "Don't slow the shelf open"
    ]
